) +
theme_bw(base_size = 12) + theme(legend.position = "right")
}
p_nit_adj_sec_qc <- ggplot(df_nit_adj_qc, aes(x = CYCLE_NUMBER, y = PRES, color = NITRATE_ADJUSTED_QC)) +
geom_point(alpha = 0.7, size = 1.2) +
